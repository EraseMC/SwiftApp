    "cl.howTournamentsBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A club hosts a bracket of 4, 8 or 16 clubs. Every club pays the entry fee, from 500 to 5 000 coins, and the finalists split the pot."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клуб собирает сетку на 4, 8 или 16 клубов. Каждый платит взнос от 500 до 5 000 коинов, финалисты делят банк."
          }
        }
      }
    },
