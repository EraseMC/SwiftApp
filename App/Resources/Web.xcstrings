    },
    "tiers.inactive": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inactive: no games in this mode for 60 days, so the tier does not count towards points."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неактивен: 60 дней без игр в этом режиме, поэтому тир не идёт в очки."
          }
        }
      }
    },
    "tiers.info.howBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type /tiertest in the game and join the queue of a mode. A tester plays a short series with you and grades your aim, movement and game sense. No ranked games are required. A retest is possible every 14 days. Staff can also assign a tier without a test."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напиши /tiertest в игре и встань в очередь режима. Тестер сыграет с тобой короткую серию и оценит аим, передвижение и понимание игры. Рейтинговые игры не требуются. Повторный тест можно пройти раз в 14 дней. Staff также может выдать тир без теста."
          }
        }
      }
    },
    "tiers.info.howHeading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How to get a tier"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как получить тир"
          }
        }
      }
    },
    "tiers.info.inactiveBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A tier fades after 60 days without games in its mode and stops counting towards points. Play the mode again and it comes back."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тир становится серым после 60 дней без игр в режиме и перестаёт давать очки. Сыграй в режим снова, и он вернётся."
          }
        }
      }
    },
    "tiers.info.inactiveHeading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inactive tiers"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неактивные тиры"
          }
        }
      }
    },
    "tiers.info.leaguesBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android and iOS players belong to PE, even when their launcher reports keyboard input. Other devices use PE for touch input and PC for mouse, keyboard or gamepad. The league is tracked throughout the test."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Игроки Android и iOS относятся к PE, даже если лаунчер сообщает управление клавиатурой. На остальных устройствах тач относится к PE, мышь, клавиатура и геймпад — к PC. Лига отслеживается на протяжении всего теста."
          }
        }
      }
    },
    "tiers.info.leaguesHeading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
