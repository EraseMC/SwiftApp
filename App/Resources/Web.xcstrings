    "tiers.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiers run from LT5 to HT1. Get tested or receive a tier from the staff. Phone and PC players have separate leagues."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тиры от LT5 до HT1 можно получить после теста или по решению Staff. У игроков с телефона и с ПК отдельные лиги."
          }
        }
      }
    },
    "tiers.byHand": {
      "extractionState": "manual",
